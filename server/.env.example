PORT=5000
# Min 32 chars. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
# Supabase Postgres - NOTE: URL-encode special chars in the password (@ -> %40)
DATABASE_URL=postgresql://postgres.<project-ref>:<password-%40for-@>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: PEM CA certificate to fully verify TLS (the pooler uses a self-signed chain).
# Provide newlines as literal \n sequences.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
